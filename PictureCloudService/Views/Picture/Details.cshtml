@model PictureCloudService.Models.Picture

@{
    var pageUrl = Context.Request.Scheme + "://" +
                  Context.Request.Host +
                  Context.Request.Path;

    var text = $"Share: {Model.Title}";
}

<div class="picture-details">

    <div class="picture-image-wrapper">
        <img src="@ViewBag.PictureUrl"
             class="picture-full"
             alt="@Model.Title" />
    </div>

    <div class="picture-meta">

        <h2 class="picture-title">
            @Model.Title
        </h2>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="picture-description">
                @Model.Description
            </p>
        }

        <div class="picture-actions-row">

            <form asp-action="ToggleLike"
                  asp-controller="Picture"
                  method="post"
                  class="like-form">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="pictureId"
                       value="@Model.Id" />

                <button type="submit"
                        class="like-btn @(ViewBag.IsLiked ? "liked" : "")">
                    ❤️ @ViewBag.LikeCount
                </button>
            </form>

            <a href="https://t.me/share/url?url=@Uri.EscapeDataString(pageUrl)&text=@Uri.EscapeDataString(text)"
               target="_blank"
               rel="noopener noreferrer"
               class="telegram-share">
                📤 Share
            </a>

        </div>

    </div>

    <hr />

    <div class="comments-section">

        <h3>Comments</h3>

        @if (Model.Comments?.Any() == true)
        {
            foreach (var comment in Model.Comments)
            {
                <div class="comment">

                    <div class="comment-header">
                        <strong>@comment.User.Personne.Login</strong>
                    </div>

                    <p class="comment-content">
                        @comment.Content
                    </p>

                </div>
            }
        }
        else
        {
            <p class="no-comments">No comments yet</p>
        }

    </div>

    <form asp-action="AddComment"
          method="post"
          class="comment-form">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="PictureId"
               value="@Model.Id" />

        <textarea name="Content"
                  placeholder="Write a comment..."
                  required></textarea>

        <button type="submit">
            Comment
        </button>

    </form>

</div>
