@model IEnumerable<PictureCloudService.Models.Collection>

@{
    ViewData["Title"] = "My collections";
}

<h1>My collections</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">➕ Create collection</a>
</p>

@if (!Model.Any())
{
    <p>No collections yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Public</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Title</td>
                    <td>@(c.IsPublic ? "Yes" : "No")</td>
                    <td>@c.CreatedAt.ToShortDateString()</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-info">View</a>
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-warning">Edit</a>

                        <form asp-action="Delete"
                              asp-route-id="@c.Id"
                              method="post"
                              style="display:inline">
                            <button type="submit"
                                    class="btn btn-sm btn-danger"
                                    onclick="return confirm('Delete this collection?');">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
