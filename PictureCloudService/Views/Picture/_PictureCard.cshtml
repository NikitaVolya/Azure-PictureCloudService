@model PictureCloudService.Models.Picture

<div class="picture-card">
    <a asp-action="Details" asp-route-id="@Model.Id">
        <img src="@ViewBag.PictureUrls[Model.Id]"
             alt="@Model.Title"
             class="picture-thumb" />
    </a>

    <div class="picture-info">
        <strong>@Model.Title</strong>

        <div class="picture-actions">
            <p class="like-btn"
                    data-id="@Model.Id"
                    onclick="toggleLike(this)">
                ❤️ <span id="likes-@Model.Id">0</span>
            </p>
        </div>
    </div>
</div>
